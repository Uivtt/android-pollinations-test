<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎤 Whisper 转录测试"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FF212121"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="使用 Pollinations AI Whisper Large V3 模型进行语音转文字"
            android:textSize="12sp"
            android:textColor="#FF757575"
            android:layout_marginBottom="24dp"/>

        <!-- Language Selector -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="选择语言"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">

            <AutoCompleteTextView
                android:id="@+id/spLanguage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:text="zh (中文)"/>

        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="测试音频"
            android:textSize="14sp"
            android:textColor="#FF616161"
            android:layout_marginBottom="8dp"/>

        <!-- Test Audio Buttons -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTestTone"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="🔊 播放测试音（正弦波 440Hz）"
            android:backgroundTint="#FF1976D2"
            android:layout_marginBottom="8dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTranscribeTone"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="📝 转录测试音"
            android:backgroundTint="#FF388E3C"
            android:layout_marginBottom="24dp"/>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#FFE0E0E0"
            android:layout_marginBottom="16dp"/>

        <!-- Result Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.MaterialComponents.CardView">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="转录结果"
                    android:textSize="12sp"
                    android:textColor="#FF757575"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tvResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="点击「转录测试音」开始测试..."
                    android:textSize="18sp"
                    android:textColor="#FF212121"
                    android:lineSpacingMultiplier="1.4"/>

                <TextView
                    android:id="@+id/tvDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textSize="11sp"
                    android:textColor="#FF9E9E9E"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Progress -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:visibility="gone"/>

    </LinearLayout>

</ScrollView>
